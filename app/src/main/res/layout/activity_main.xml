<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Planer treningów"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#1976D2"
        android:layout_marginBottom="12dp" />

    <ImageView
        android:id="@+id/imgSportowiec"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:scaleType="centerCrop"
        android:src="@drawable/sportowiec"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnLosuj"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="LOSUJ ĆWICZENIE"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#1976D2"
        android:layout_marginBottom="12dp" />

    <ImageView
        android:id="@+id/imgCwiczenie"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:scaleType="fitCenter"
        android:src="@drawable/cwiczenie0"
        android:background="#F5F5F5"
        android:padding="8dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvNazwaCwiczenia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Losuj ćwiczenie"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="12dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnMinus"
            android:layout_width="70dp"
            android:layout_height="55dp"
            android:text="-"
            android:textSize="24sp"
            android:textStyle="bold"
            android:backgroundTint="#CFD8DC"
            android:textColor="#37474F" />

        <TextView
            android:id="@+id/tvLicznikSerii"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="3"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center" />

        <Button
            android:id="@+id/btnPlus"
            android:layout_width="70dp"
            android:layout_height="55dp"
            android:text="+"
            android:textSize="24sp"
            android:textStyle="bold"
            android:backgroundTint="#CFD8DC"
            android:textColor="#37474F" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnNastepne"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="NASTĘPNE\nĆWICZENIE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#388E3C"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="RESET"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvLacznaLiczbaSerii"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="Łączna liczba serii: 12"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#37474F"
        android:gravity="center"
        android:background="#ECEFF1" />

</LinearLayout>